# Everything under data/ is machine-generated by the harvest pipeline. Marking it as such
# keeps the repository's language stats honest (the outputs are JSON blobs, and they would
# otherwise dominate a repository whose actual content is Python) and collapses the directory
# in diffs, so a review can focus on code and recipes instead of snapshot churn.
#
# There is deliberately no `-text` rule here. The shards are written as compact single-line
# JSON, so there are no line endings to normalise; the `*.json text eol=lf` rule below already
# governs them, and a `-text` rule would be overridden by it anyway.
data/** linguist-generated=true -diff

# Recipe and registry files are the hand-maintained source of truth -- always text, always
# shown in diffs.
sites/** text
config/** text

# Fixtures are recorded third-party responses; they are data, not code, but they *are* reviewed
# (they are the regression baseline), so leave them diffable.
tests/fixtures/** -linguist-generated

# Normalise line endings for source files.
*.py text eol=lf
*.js text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.toml text eol=lf
*.txt text eol=lf
